# Conexao com o Postgres (Stage)
# Use "postgres" quando rodar dentro do docker-compose;
# use "localhost" se rodar o coletor fora do container.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=arp_stage
DB_USER=arp
DB_PASSWORD=arp

# API de dados abertos do Compras.gov.br
API_BASE_URL=https://dadosabertos.compras.gov.br

# Janela de coleta (vigencia das atas) - parametros obrigatorios da API
DATA_VIGENCIA_MIN=2026-01-01
DATA_VIGENCIA_MAX=2026-01-31

# Paginacao e resiliencia
TAMANHO_PAGINA=500
MAX_RETRIES=5
BACKOFF_FACTOR=1.5
REQUEST_TIMEOUT=60
